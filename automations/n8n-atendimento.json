{
  "name": "Odontologia — receber e organizar solicitação",
  "nodes": [
    {
      "id": "receive",
      "name": "Receber evento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "clinic-intake",
      "parameters": {
        "httpMethod": "POST",
        "path": "clinic-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "prepare",
      "name": "Definir próximo passo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "event",
              "name": "event_id",
              "type": "string",
              "value": "={{ $json.body.event_id }}"
            },
            {
              "id": "lead",
              "name": "lead_id",
              "type": "string",
              "value": "={{ $json.body.lead_id }}"
            },
            {
              "id": "status",
              "name": "status",
              "type": "string",
              "value": "={{ $json.body.status }}"
            },
            {
              "id": "action",
              "name": "proxima_acao",
              "type": "string",
              "value": "={{ ({ novo: 'Revisar solicitação e iniciar contato', em_contato: 'Combinar disponibilidade com a pessoa', agendado: 'Acompanhar atendimento confirmado', cancelado: 'Encerrar acompanhamento' })[$json.body.status] || 'Revisar evento' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond",
      "name": "Confirmar recebimento",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true, event_id: $json.event_id, proxima_acao: $json.proxima_acao } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Receber evento": {
      "main": [
        [
          {
            "node": "Definir próximo passo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Definir próximo passo": {
      "main": [
        [
          {
            "node": "Confirmar recebimento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
